# URL de la implementación web de Google Apps Script.
# Si no se define, la app usa la URL de respaldo configurada en src/config/app.js.
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/REEMPLAZAR/exec

# Integración V9 en Vercel - variables PRIVADAS del entorno Preview.
# No agregues sus valores a GitHub, ni uses prefijo VITE_ para credenciales.
# DELTA_V9_ADMIN_TOKEN: token aleatorio >= 24 caracteres (recomendado >= 32).
# DELTA_V9_SUPABASE_URL: https://jwfocqaxlckuxoklwyxs.supabase.co
# DELTA_V9_SUPABASE_SERVICE_KEY: service_role/secret server-side del proyecto.
# DELTA_V9_GAS_URL: URL /exec del Apps Script CLON V9 (solo health).
# Todas son OPCIONALES para compilar. Sin ellas, la API V9 falla cerrada (503).
